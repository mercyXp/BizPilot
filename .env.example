# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_ENV=development
APP_NAME=BizPilot
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-development-only

# Dedicated local cluster (see docs/setup.md). Not the system PostgreSQL on 5433.
# The API connects as bizpilot_app so row-level security applies.
# Alembic connects as the migrator (superuser locally) so it can create policies.
DATABASE_URL=postgresql+asyncpg://bizpilot_app:bizpilot@127.0.0.1:55432/bizpilot
DATABASE_URL_SYNC=postgresql+psycopg://bizpilot:bizpilot@127.0.0.1:55432/bizpilot
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# Use memory:// when a Redis server is not installed. Production must use redis://
REDIS_URL=memory://

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
