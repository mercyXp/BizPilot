# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_ENV=development
APP_NAME=BizPilot
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-development-only

# Dedicated local cluster (see docs/setup.md). Not the system PostgreSQL on 5433.
DATABASE_URL=postgresql+asyncpg://bizpilot@127.0.0.1:55432/bizpilot
DATABASE_URL_SYNC=postgresql+psycopg://bizpilot@127.0.0.1:55432/bizpilot

# Use memory:// when a Redis server is not installed. Production must use redis://
REDIS_URL=memory://

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
