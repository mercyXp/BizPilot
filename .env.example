# Copy to .env and adjust. Never commit .env.

# --- Backend ---
APP_ENV=development
APP_NAME=BizPilot
API_V1_PREFIX=/api/v1
SECRET_KEY=change-me-in-development-only

# Dedicated local cluster (see docs/setup.md). Not the system PostgreSQL on 5433.
# App role has no BYPASSRLS. Alembic uses the cluster owner.
DATABASE_URL=postgresql+asyncpg://bizpilot_app@127.0.0.1:55432/bizpilot
DATABASE_URL_SYNC=postgresql+psycopg://bizpilot@127.0.0.1:55432/bizpilot
# Staging/production (Render): owner URL in DATABASE_URL, plus BIZPILOT_APP_PASSWORD.
# BIZPILOT_APP_PASSWORD=
PUBLIC_APP_URL=http://localhost:3000

# Use memory:// when a Redis server is not installed. Production must use redis://
REDIS_URL=memory://

CORS_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO

# Transactional email (Resend). Leave the key empty in development to log only.
# Never commit a real key. Tests set APP_ENV=test and never call Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BizPilot <noreply@your-verified-domain>

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
